// 语音悬浮球组件：复制本文件 → 改名 VoiceFab.jsx 放 src/components/。
// 通用：仅在设计稿里有才做，没有就别在 App.jsx 里渲染（约定见 00 §9）。
// 位置存 App 层 fabPos；静止/发光两态由 glow 控制。
import { useRef } from 'react'

export default function VoiceFab({ glow = false, pos = { x: 0, y: 0 }, setPos, onToggle }) {
  const ref = useRef(null)
  const drag = useRef(null)

  const onPointerDown = (e) => {
    const r = ref.current.getBoundingClientRect() // 视口坐标（已含缩放）
    drag.current = { startX: e.clientX, startY: e.clientY, base: { ...pos } }
    ref.current.setPointerCapture(e.pointerId)
  }
  const onPointerMove = (e) => {
    if (!drag.current) return
    // ⚠️ 页面被 scale 后，视口位移要除以缩放系数，才等于手机内的坐标位移（见 00 §9 / 05）
    const scale =
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--app-scale')) || 1
    setPos?.({
      x: drag.current.base.x + (e.clientX - drag.current.startX) / scale,
      y: drag.current.base.y + (e.clientY - drag.current.startY) / scale,
    })
  }
  const onPointerUp = () => { drag.current = null }

  return (
    <button
      ref={ref}
      className={'voice-fab' + (glow ? ' is-active' : '')}
      style={{ left: pos.x, top: pos.y }}
      onPointerDown={onPointerDown}
      onPointerMove={onPointerMove}
      onPointerUp={onPointerUp}
      onClick={onToggle}
      aria-label="语音"
    >
      {/* TODO: 放你的 icon（静止/发光两态）；没素材先留灰块占位（见 00 §8） */}
    </button>
  )
}
